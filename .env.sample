# Server
SERVER_PORT=8080
SERVER_IP=127.0.0.1
SERVER_DOMAIN=localhost

# Database (Postgres) — see docker-compose.yml for the dev defaults
DATABASE_URL=postgres://rxuser:devpass@localhost:5432/rxserver

# osu! API key — optional in dev
OSU_KEY=

# Discord webhooks — optional in dev
SUBMIT_DISCORD=
WL_DISCORD=

# Server-side signing keys (HMAC-style "sign" used by client requests).
# Use long random strings in production.
WL_KEY=devwlkey
LOGIN_KEY=devloginkey
